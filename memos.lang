# Multilingual file for TOS 7 Docker application. All 14 languages are REQUIRED.

[en-us]
name = "Memos"
auth = "waskevin"
descript = "Memos is a lightweight, self-hosted memo hub. Capture notes in Markdown with tags and full-text search. All data stays on your TNAS in a single SQLite file."
release_note = "1.0.4: added licence/attribution notices and a privacy policy."
important = "DockerEngine must be installed and enabled from the TOS App Center. Docker image source: Docker Hub. License: MIT. Source code, notices and privacy policy: https://github.com/waskevin/memos"

